class_name EncounterZone
extends Area2D
## Encounter zone: when the player steps inside, the energy barriers seal it and `waves` spawn one
## after another (each enemy warps in at a telegraphed spot away from the player). Clearing the last
## wave drops the barriers and emits `cleared` (the arena then opens the boss door).
##
## Wave format (one string per wave):  "chaser:4, shooter:2, tank:1"
##
## ENDLESS (`endless = true`): waves never run out. Each one is generated by endless_wave(): more
## enemies, tougher mixes and +hp_ramp HP / +damage_ramp damage per wave. Every boss wave is emitted
## with `total` 0 like any other wave; the arena adds the boss via reserve() + track().

signal started
signal wave_started(index: int, total: int)
signal wave_cleared(index: int, total: int)
signal cleared

const ENEMIES := {
	"chaser": preload("res://enemies/chaser.tscn"),
	"shooter": preload("res://enemies/shooter.tscn"),
	"tank": preload("res://enemies/heavy_tank.tscn"),
	"striker": preload("res://enemies/blade_striker.tscn"),
	"aegis": preload("res://enemies/aegis_guardian.tscn"),
	"lancer": preload("res://enemies/lancer.tscn"),
	# Endless-only robots (see endless_wave).
	"hornet": preload("res://enemies/hornet.tscn"),
	"coil": preload("res://enemies/coil.tscn"),
	"widow": preload("res://enemies/widow.tscn"),
	"cinder": preload("res://enemies/cinder.tscn"),
	"bastion": preload("res://enemies/bastion.tscn"),
	"tidebreaker": preload("res://enemies/tidebreaker.tscn"),
	# Volcanic Forge robots (level 6; also join Endless, see endless_wave).
	"crawler": preload("res://enemies/magma_crawler.tscn"),
	"anvil": preload("res://enemies/anvil.tscn"),
	"spitter": preload("res://enemies/slagspitter.tscn"),
	# Titan Graveyard robots (level 7; also join Endless).
	"burrower": preload("res://enemies/dune_burrower.tscn"),
	"skiff": preload("res://enemies/sand_skiff.tscn"),
	"helio": preload("res://enemies/heliostat.tscn"),
	# Orbital Dry Dock robots (level 8; also join Endless).
	"skimmer": preload("res://enemies/void_skimmer.tscn"),
	"magmine": preload("res://enemies/mag_mine_drone.tscn"),
	"tug": preload("res://enemies/grav_tug.tscn"),
	# The HORDE robot: Campaign sectors fill the gaps between the tough robots with packs of these.
	"mite": preload("res://enemies/scrap_mite.tscn"),
}
## SWARMS: "mite" entries warp in MITE_PACK at a time from one big ring (enemies/scrap_mite.gd), a pack every
## MITE_PACK_GAP seconds, and no more than MAX_MITES are out at once (fewer on the web / phones) - the rest
## wait their turn.
const MITE_PACK := 10
const MITE_PACK_GAP := 2.4
const MAX_MITES := 50
const MAX_MITES_MOBILE := 32
const MITE_RUST := Color(1.0, 0.55, 0.25)

@export var waves: PackedStringArray = [
	"chaser:4",
	"chaser:3, shooter:2",
	"chaser:3, shooter:1, tank:2",
	"shooter:4, tank:2",
	"chaser:5, shooter:2, tank:2",
]
@export var zone_size := Vector2(1600, 900)
@export var hp_mult := 1.0
@export var damage_mult := 1.0
## Extra HP per wave (0.08 = +8% each wave).
@export var hp_ramp := 0.08
## From this wave on (1-based), random artillery shells rain on the player every few seconds.
@export var bombard_from_wave := 3
@export var bombard_interval := 5.0
@export var endless := false
## Extra enemy damage per wave (0.04 = +4% each wave, capped at MAX_DAMAGE_RAMP).
@export var damage_ramp := 0.0
## Endless: most enemies spawned in one wave (after that, waves only get tougher, not bigger).
const MAX_ENDLESS_ENEMIES := 22
const MAX_ENDLESS_ABSOLUTE := 36
const MAX_ENDLESS_ABSOLUTE_MOBILE := 26
const MAX_DAMAGE_RAMP := 2.5

var barriers: Array[Node] = []
var spawn_points: PackedVector2Array = []
var enemy_parent: Node
var wave := 0
var is_running := false
var is_cleared := false
var _alive: Array[Enemy] = []
var _pending := 0
var _bombard_t := 0.0
## Stall guard (see _check_stall).
const STALL_TIME := 20.0
const STALL_MAX_LEFT := 3
const STALL_BOSS_FAR := 900.0
var _stall_t := 0.0
## OVERLAPPING WAVES: once a fully spawned wave is down to its last OVERLAP_LEFT robots for OVERLAP_DELAY
## seconds, it counts as beaten and the next wave warps in while those stragglers are still around
## (they simply join it), so the action never stalls on hunting the last robot. Never out of a boss
## wave, the campaign's final wave, or while a boss lives - those have to be finished.
## `last_overlapped` tells wave_cleared listeners which kind of clear it was.
const OVERLAP_LEFT := 2
const OVERLAP_DELAY := 2.5
## (tests can switch it off to exercise the stall guard)
var overlap_enabled := true
var last_overlapped := false
var _overlap_t := 0.0
## The next wave is already on its way (cleared or overlapped; _next_wave resets it).
var _advancing := false
## Late Endless elites (see elite_chance).
const LATE_ELITE_WAVE := 15
const LATE_ELITE_WAVE_EASY := 25


func _ready() -> void:
	collision_layer = 0
	collision_mask = 2
	monitorable = false
	var shape := CollisionShape2D.new()
	var box := RectangleShape2D.new()
	box.size = zone_size
	shape.shape = box
	add_child(shape)
	body_entered.connect(_on_body_entered)


func _on_body_entered(body: Node) -> void:
	if body is Mech and not is_running and not is_cleared:
		start()


func start() -> void:
	is_running = true
	for b in barriers:
		b.active = true
	started.emit()
	get_tree().create_timer(1.2, false).timeout.connect(_next_wave)


func alive_count() -> int:
	return _alive.size() + _pending


## Number of waves (0 = endless).
func total_waves() -> int:
	return 0 if endless else waves.size()


func is_boss_wave(n: int) -> bool:
	return endless and n > 0 and n % Game.ENDLESS_BOSS_EVERY == 0


## Enemy damage multiplier for the current wave.
func wave_damage_mult() -> float:
	return damage_mult * Game.diff("damage") * minf(1.0 + damage_ramp * (wave - 1), MAX_DAMAGE_RAMP) \
		* Game.twist_value("enemy_damage")


## Endless wave `n`: grows by ~1.4 enemies a wave (capped); shooters join at wave 2, heavy tanks at 3,
## blade strikers at 4, lancers at 6, aegis guardians at 8 - and all of them get more common later.
## The Endless-only robots join too: Hornet drones at 3 (in pairs), Coils at 5, Widows at 7, Cinders at 9,
## Bastions at 11 and the Tidebreaker mini-boss at 12 (those last two are capped per wave).
## The Volcanic Forge robots too: Magma Crawlers at 4, Slagspitters at 6, Anvils at 10 (capped).
## Then the Titan Graveyard / Orbital Dry Dock robots: Sand Skiffs at 7, Void Skimmers at 8, Dune Burrowers
## at 9, Heliostats at 11, Mag Mine Drones at 13 and Grav Tugs at 15 (drones and tugs capped).
## Boss waves bring a few escorts instead of a full wave.
func endless_wave(n: int) -> Array[String]:
	# (the SWARM twist packs more robots in; see Game.TWISTS)
	var count := mini(roundi((4 + int(n * 1.4)) * Game.twist_value("count")), roundi(MAX_ENDLESS_ENEMIES * Game.twist_value("count")))
	if is_boss_wave(n):
		count = mini(2 + n / Game.ENDLESS_BOSS_EVERY, 8)
	var kinds: Array = [["chaser", 1.0]]
	if n >= 2:
		kinds.append(["shooter", 0.7])
	if n >= 3:
		kinds.append(["tank", 0.15 + minf(n * 0.015, 0.25)])
	# Tougher robots join as the waves go on: Blade Strikers from 4, Lancers from 6, Aegis Guardians from 8.
	if n >= 4:
		kinds.append(["striker", 0.35 + minf(n * 0.01, 0.2)])
	if n >= 6:
		kinds.append(["lancer", 0.25 + minf(n * 0.01, 0.2)])
	if n >= 8:
		kinds.append(["aegis", 0.15 + minf(n * 0.008, 0.15)])
	if n >= 3:
		kinds.append(["hornet", 0.3 + minf(n * 0.01, 0.2)])
	if n >= 5:
		kinds.append(["coil", 0.25 + minf(n * 0.01, 0.15)])
	if n >= 7:
		kinds.append(["widow", 0.2 + minf(n * 0.008, 0.15)])
	if n >= 9:
		kinds.append(["cinder", 0.15 + minf(n * 0.008, 0.15)])
	if n >= 11:
		kinds.append(["bastion", 0.12])
	if n >= 12:
		kinds.append(["tidebreaker", 0.06 + minf(n * 0.002, 0.06)])
	if n >= 4:
		kinds.append(["crawler", 0.25 + minf(n * 0.01, 0.15)])
	if n >= 6:
		kinds.append(["spitter", 0.15 + minf(n * 0.008, 0.12)])
	if n >= 10:
		kinds.append(["anvil", 0.12 + minf(n * 0.005, 0.08)])
	if n >= 7:
		kinds.append(["skiff", 0.15 + minf(n * 0.006, 0.1)])
	if n >= 8:
		kinds.append(["skimmer", 0.15 + minf(n * 0.006, 0.1)])
	if n >= 9:
		kinds.append(["burrower", 0.15 + minf(n * 0.006, 0.1)])
	if n >= 11:
		kinds.append(["helio", 0.1 + minf(n * 0.004, 0.08)])
	if n >= 13:
		kinds.append(["magmine", 0.08])
	if n >= 15:
		kinds.append(["tug", 0.06 + minf(n * 0.002, 0.06)])
	# Per-wave caps for the elites (one more of each every 10 waves).
	var caps := {"bastion": 1 + n / 10, "tidebreaker": 1 + n / 20, "anvil": 2 + n / 10, "magmine": 2 + n / 20,
		"tug": 1 + n / 15}
	var total := 0.0
	for k in kinds:
		total += k[1]
	var list: Array[String] = []
	while list.size() < count:
		var r := randf() * total
		for k in kinds:
			r -= k[1]
			if r <= 0.0:
				var kind: String = k[0]
				if caps.has(kind) and list.count(kind) >= caps[kind]:
					break
				list.append(kind)
				# Hornets come in pairs.
				if kind == "hornet" and list.size() < count:
					list.append(kind)
				break
	return list


func _next_wave() -> void:
	_advancing = false
	_overlap_t = 0.0
	wave += 1
	Game.run_waves += 1  # difficulty WARM-UP (Game.warmup)
	wave_started.emit(wave, total_waves())
	var list: Array[String] = []
	if endless:
		list = endless_wave(wave)
	else:
		for part in waves[wave - 1].split(",", false):
			var kv := part.strip_edges().split(":")
			for i in (int(kv[1]) if kv.size() > 1 else 1):
				list.append(kv[0].strip_edges())
	list = _scale_for_difficulty(list)
	var mites := list.count("mite")
	list.assign(list.filter(func(k: String) -> bool: return k != "mite"))
	list.shuffle()
	_pending += list.size() + mites
	for i in list.size():
		get_tree().create_timer(0.2 + i * 0.25, false).timeout.connect(_telegraph_spawn.bind(list[i]))
	var packs := ceili(mites / float(MITE_PACK))
	for p in packs:
		var n := mini(MITE_PACK, mites - p * MITE_PACK)
		get_tree().create_timer(0.8 + p * MITE_PACK_GAP, false).timeout.connect(_telegraph_pack.bind(n))


func mites_out() -> int:
	var n := 0
	for e in _alive:
		if is_instance_valid(e) and e is ScrapMite:
			n += 1
	return n


func _mite_cap() -> int:
	return MAX_MITES_MOBILE if OS.has_feature("web") or OS.has_feature("mobile") else MAX_MITES


## A pack of `n` Scrap Mites: one big rust-orange warp ring, then they spill out of it.
func _telegraph_pack(n: int) -> void:
	if not is_running:
		_pending = maxi(_pending - n, 0)
		return
	if mites_out() + n > _mite_cap():
		get_tree().create_timer(1.0, false).timeout.connect(_telegraph_pack.bind(n))
		return
	var pos := _pick_spawn_point()
	for k in 3:
		get_tree().create_timer(k * 0.2, false).timeout.connect(func() -> void:
			Combat.shockwave(pos, 110.0 - k * 25.0, MITE_RUST, 0.32))
	for i in n:
		var at := pos + Vector2.from_angle(TAU * i / n + randf() * 0.5) * randf_range(10.0, 46.0)
		get_tree().create_timer(0.6 + i * 0.05, false).timeout.connect(_spawn.bind("mite", at))


## Difficulty: more or fewer enemies per wave (Game.diff("count")). Removes random ones (keeping at least
## 2) or adds copies of random ones. Endless waves stay under a (modestly) raised cap.
func _scale_for_difficulty(list: Array[String]) -> Array[String]:
	var want := maxi(roundi(list.size() * Game.diff("count")), mini(2, list.size()))
	if not endless:  # (a Campaign sector's SWARM twist; Endless builds it into endless_wave)
		want = roundi(want * Game.twist_value("count"))
	if endless:
		want = mini(want, roundi(MAX_ENDLESS_ENEMIES * minf(Game.diff("count"), 1.4) * Game.twist_value("count")))
		# (hard ceiling, so a SWARM on Hard / Extreme stays smooth: 40 robots cost ~6 ms of CPU a frame on
		# a desktop, so the web / phone builds keep it lower)
		var ceiling := MAX_ENDLESS_ABSOLUTE_MOBILE if OS.has_feature("web") or OS.has_feature("mobile") else MAX_ENDLESS_ABSOLUTE
		want = mini(want, ceiling)
	var out := list.duplicate()
	out.shuffle()
	while out.size() > want:
		out.pop_back()
	# Extra copies never duplicate the capped elites (Bastion, Tidebreaker).
	var fill := list.filter(func(k: String) -> bool: return k not in ["bastion", "tidebreaker"])
	if fill.is_empty():
		fill = list
	while out.size() < want:
		out.append(fill.pick_random())
	return out


## An enemy the arena will add to this wave later (e.g. a boss that drops in after a telegraph):
## the wave can't clear until it has been track()ed and killed.
func reserve() -> void:
	_pending += 1


## Adds an externally spawned enemy to the current wave (pair with reserve()).
func track(e: Enemy) -> void:
	_pending = maxi(_pending - 1, 0)
	e.died.connect(_on_enemy_died)
	_alive.append(e)


## A ready-made special enemy (a RIVAL PILOT) joins the current wave at `pos`, scaled like the wave's own
## robots. Pair with reserve() when it was announced earlier, so the wave waited for it.
func add_special(e: Enemy, pos: Vector2) -> void:
	_pending = maxi(_pending - 1, 0)
	e.position = pos
	e.max_hp *= hp_mult * (1.0 + hp_ramp * (wave - 1)) * Game.diff("hp") * Game.twist_value("enemy_hp")
	e.move_speed *= sqrt(Game.diff("speed")) * Game.twist_value("enemy_speed")
	e.damage_mult = wave_damage_mult()
	e.died.connect(_on_enemy_died)
	_alive.append(e)
	(enemy_parent if enemy_parent else get_parent()).add_child(e)


func _telegraph_spawn(kind: String) -> void:
	var pos := _pick_spawn_point()
	# Warp-in telegraph: a pulsing magenta ring for 0.7 s.
	for k in 3:
		get_tree().create_timer(k * 0.22, false).timeout.connect(func() -> void:
			Combat.shockwave(pos, 70.0 - k * 15.0, Color(1.0, 0.3, 0.8), 0.3))
	get_tree().create_timer(0.7, false).timeout.connect(_spawn.bind(kind, pos))


## THREAT BOSS ESCORT: an ELITE `kind` warps in at `pos` (telegraphed like any spawn) and joins the current
## wave (so an Endless boss wave waits for it; after a campaign wave is over it simply roams).
func spawn_guard(kind: String, pos: Vector2) -> void:
	reserve()
	for k in 3:
		get_tree().create_timer(k * 0.22, false).timeout.connect(func() -> void:
			Combat.shockwave(pos, 70.0 - k * 15.0, Enemy.ELITE_GOLD, 0.3))
	get_tree().create_timer(0.7, false).timeout.connect(_spawn.bind(kind, pos, true))


func _spawn(kind: String, pos: Vector2, force_elite := false) -> void:
	_pending -= 1
	if not ENEMIES.has(kind):
		push_warning("Unknown enemy kind '%s'" % kind)
		_check_clear()
		return
	var e: Enemy = ENEMIES[kind].instantiate()
	e.position = pos
	e.max_hp *= hp_mult * (1.0 + hp_ramp * (wave - 1)) * Game.diff("hp") * Game.twist_value("enemy_hp")
	e.move_speed *= Game.diff("speed") * Game.twist_value("enemy_speed")
	e.damage_mult = wave_damage_mult()
	# Tank-type enemies: armor tier by wave - triple armor gets likelier the further in you are - and
	# early waves field thinner armor (35% of HP on the first waves, full by ~wave 9 / later arenas).
	if e is HeavyTank or e is Tidebreaker:
		e.armor_tier = 3 if randf() < triple_armor_chance() else 2
		e.armor_fraction = armor_fraction()
	# ELITES (gold aura, x2 HP, faster, harder-hitting): Extreme from the start, every difficulty late in
	# Endless (see elite_chance).
	if force_elite or (kind != "mite" and randf() < elite_chance()):
		e.make_elite()
	e.died.connect(_on_enemy_died)
	_alive.append(e)
	(enemy_parent if enemy_parent else get_parent()).add_child(e)


func _pick_spawn_point() -> Vector2:
	var mech := get_tree().get_first_node_in_group("player") as Node2D
	var best := global_position
	for i in 20:
		var p := spawn_points[randi() % spawn_points.size()] if not spawn_points.is_empty() else \
			global_position + Vector2(randf_range(-0.4, 0.4) * zone_size.x, randf_range(-0.4, 0.4) * zone_size.y)
		best = p
		if mech == null or p.distance_to(mech.global_position) > 340.0:
			break
	return best


func _on_enemy_died(e: Enemy) -> void:
	_alive.erase(e)
	_stall_t = 0.0
	# Hit feel: the wave's last robot goes down in a short slow-motion beat.
	if is_running and alive_count() == 0 and not e.is_in_group("boss"):
		Combat.slowmo(0.35, 0.7)
	_check_clear()


## Stall guard: a wave down to its last few regular enemies with no kill for STALL_TIME seconds gets
## them warped back in near the player (with the normal warp-in telegraph), so however an enemy got
## stuck or lost (wedged in scenery, unreachable spot), a wave can never soft-lock the run. In a boss
## wave the boss is ignored and only stragglers far from the mech (STALL_BOSS_FAR) are pulled back, so a
## robot lost behind scenery comes back while the ones already in the fight stay put.
func _check_stall(delta: float) -> void:
	var regular := 0
	var boss := false
	for e in _alive:
		if not is_instance_valid(e):
			continue
		if e.is_in_group("boss"):
			boss = true
		elif not (e is ScrapMite):  # (a few leftover swarm robots don't stop the rescue)
			regular += 1
	if regular == 0 and mites_out() > 0:
		regular = 1
	if not is_running or _pending > 0 or regular == 0 or regular > STALL_MAX_LEFT:
		_stall_t = 0.0
		return
	_stall_t += delta
	if _stall_t < STALL_TIME:
		return
	_stall_t = 0.0
	var mech := get_tree().get_first_node_in_group("player") as Node2D
	for e in _alive:
		if not is_instance_valid(e) or e.dead or e.is_in_group("boss"):
			continue
		if boss and mech and e.global_position.distance_to(mech.global_position) < STALL_BOSS_FAR:
			continue
		var pos := e.global_position
		if mech and not spawn_points.is_empty():
			var best := INF
			for i in 40:
				var p := spawn_points[randi() % spawn_points.size()]
				var d := p.distance_to(mech.global_position)
				var score := absf(d - 450.0)
				if d > 300.0 and score < best:
					best = score
					pos = p
		Combat.shockwave(e.global_position, 60.0, Color(1.0, 0.3, 0.8), 0.3)
		e.global_position = pos
		e.velocity = Vector2.ZERO
		for k in 3:
			get_tree().create_timer(k * 0.15, false).timeout.connect(func() -> void:
				Combat.shockwave(pos, 70.0 - k * 15.0, Color(1.0, 0.3, 0.8), 0.3))


func _check_clear() -> void:
	if not is_running or _advancing or _pending > 0 or not _alive.is_empty():
		return
	_advance(false)


## The current wave is beaten: wiped out, or (`overlapped`) down to its last stragglers - see OVERLAP_LEFT.
func _advance(overlapped: bool) -> void:
	_advancing = true
	last_overlapped = overlapped
	Upgrades.vacuum()
	Game.record_wave_cleared()
	wave_cleared.emit(wave, total_waves())
	if overlapped:
		get_tree().create_timer(1.0, false).timeout.connect(_next_wave)
	elif endless:
		get_tree().create_timer(3.5 if is_boss_wave(wave) else 2.2, false).timeout.connect(_next_wave)
	elif wave >= waves.size():
		is_running = false
		is_cleared = true
		for b in barriers:
			b.active = false
		cleared.emit()
	else:
		get_tree().create_timer(2.2, false).timeout.connect(_next_wave)


func _physics_process(delta: float) -> void:
	_check_stall(delta)
	_check_overlap(delta)
	if not is_running or wave < bombard_from_wave:
		return
	_bombard_t -= delta
	if _bombard_t <= 0.0:
		_bombard_t = bombard_interval / Game.diff("bombard")
		var mech := get_tree().get_first_node_in_group("player") as Mech
		if mech and not mech.dead:
			for i in 3:
				var off := Vector2.ZERO if i == 0 else Vector2.from_angle(randf() * TAU) * randf_range(110, 220)
				Combat.artillery(mech.global_position + mech.velocity * 0.6 + off, 75.0, 14.0 * wave_damage_mult(), null, 1.0 + i * 0.25)


## Chance a tank rolls TRIPLE armor on the current wave (20% on wave 1, +12% per wave, max 80%).
func triple_armor_chance() -> float:
	return clampf(0.2 + 0.12 * (wave - 1), 0.2, 0.8)


## Armor size (fraction of HP) for tank-type robots on the current wave: 35% early, +8% a wave, full
## from ~wave 9. Campaign arenas add 15% per arena, so the later arenas field full armor from the start.
func armor_fraction() -> float:
	var campaign := 0.0 if endless else 0.15 * Game.arena_index
	return clampf(0.35 + 0.08 * (wave - 1) + campaign, 0.35, 1.0)


## Chance a robot spawns as an ELITE: only on difficulties with an "elite" rate (Extreme), rising 1% a
## wave (max 30%).
## Overlapping waves: see OVERLAP_LEFT.
func _check_overlap(delta: float) -> void:
	var can := overlap_enabled and is_running and not _advancing and _pending == 0 and not _alive.is_empty() \
		and _alive.size() <= OVERLAP_LEFT and not is_boss_wave(wave) and (endless or wave < waves.size())
	if can:
		for e in _alive:
			if is_instance_valid(e) and e.is_in_group("boss"):
				can = false
	if not can:
		_overlap_t = 0.0
		return
	_overlap_t += delta
	if _overlap_t >= OVERLAP_DELAY:
		_overlap_t = 0.0
		_advance(true)


## LATE-GAME PRESSURE: Endless brings elites on every difficulty from wave LATE_ELITE_WAVE (Easy from
## LATE_ELITE_WAVE_EASY), starting at 5% and +1.5% a wave, so strong builds keep meeting real threats.
## The ELITE SURGE twist adds +25% on top. Max 40%.
func elite_chance() -> float:
	var c := 0.0
	if Game.diff("elite") > 0.0:
		c = Game.diff("elite") + 0.01 * (wave - 1)
	if endless:
		var from := LATE_ELITE_WAVE_EASY if Game.difficulty == 0 else LATE_ELITE_WAVE
		if wave >= from:
			c = maxf(c, 0.05 + 0.015 * (wave - from))
	c += Game.twist_value("elite_add", 0.0)
	# (THREAT tiers raise Game.diff("elite"), and the ceiling with it)
	return clampf(c, 0.0, 0.4 + maxf(Game.diff("elite") - float(Game.DIFFICULTIES[Game.difficulty]["elite"]), 0.0))
